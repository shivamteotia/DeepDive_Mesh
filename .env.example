# Copy to .env and fill in. .env is gitignored; never commit a real key.
# In CI these come from GitHub repo secrets (Settings -> Secrets and variables -> Actions).

Mesh_AI_API_Key=rsk_your_router_service_key   # the only required value
SUBMISSION_TOKEN=                              # from the hackathon portal registration

# --- models, one per agent role (optional; defaults in backend/config.py) ---
# OpenAI everywhere because an OpenAI key is registered as BYOK on the Mesh dashboard, so
# these bill to that key rather than the Mesh balance. Cheap by default; the drafter and
# synthesizer need 1M context for the evidence block, which is why they are nano and not
# 4o-mini. Uncomment to override.
# PLANNER_MODEL=openai/gpt-4o-mini
# RESEARCHER_MODEL=openai/gpt-4o-mini        # unused: research() makes no chat call
# DRAFTER_MODEL=openai/gpt-4.1-nano
# VERIFIER_MODEL=openai/gpt-4o-mini          # must differ from DRAFTER_MODEL
# SYNTHESIZER_MODEL=openai/gpt-4.1-nano
# UTILITY_MODEL=openai/gpt-5-nano
# EVALUATE_MODEL=typesafe/jev-1.13           # only evaluation model; not covered by BYOK
# EMBEDDING_MODEL=openai/text-embedding-3-small
#
# For a quality run instead of a cheap one:
# DRAFTER_MODEL=openai/gpt-5.5
# VERIFIER_MODEL=google/gemini-3.1-pro-preview   # cross-family checking, leaves the BYOK key

# --- web search ---
# WEBSEARCH=live                  # live | replay  (evals gate in replay)
# WEBSEARCH_PROVIDER=tinyfish     # the only engine that returns page_content
# WEBSEARCH_RESULTS=6

# --- verification loop ---
# VERIFY_ACCEPT_THRESHOLD=0.70
# MAX_LOOPBACKS=2
# MAX_SUBQUESTIONS=5
